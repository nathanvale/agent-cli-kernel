{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "profiles/**",
    "examples/**",
    "starters/simple/**",
    "starters/complex/**",
    "starters/shared/**"
  ],
  "ignoreBinaries": ["getconf"],
  "typeAware": {
    "enabled": true,
    "require": "complete"
  },
  "audit": {
    "gate": "new-only"
  },
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": ["src/**"]
      },
      {
        "name": "scripts",
        "patterns": ["scripts/**"]
      },
      {
        "name": "contract3-starter",
        "patterns": ["starters/contract3/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**"]
      },
      {
        "name": "lint-config",
        "patterns": ["eslint.config.mjs", "eslint-rules.mjs", "config/**"]
      }
    ],
    "rules": [
      {
        "from": "cli",
        "allow": []
      },
      {
        "from": "scripts",
        "allow": ["cli"]
      },
      {
        "from": "contract3-starter",
        "allow": []
      },
      {
        "from": "tests",
        "allow": ["cli", "scripts", "contract3-starter", "lint-config"]
      },
      {
        "from": "lint-config",
        "allow": []
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  },
  "rules": {
    "dev-dependencies-in-production": "error",
    "private-type-leaks": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "boundary-violation": "error"
  },
  "entry": [
    "src/static-admission.ts",
    "scripts/doctor.ts",
    "scripts/check-commits.ts",
    "scripts/faults.ts",
    "scripts/test-area.ts",
    "starters/contract3/src/kernel/index.ts",
    "starters/contract3/src/kernel/pattern-worker.ts",
    "starters/contract3/src/addons/programs/index.ts",
    "starters/contract3/src/addons/diagnostics/index.ts",
    "tests/contract3/**/fixtures/*-cli.ts",
    "tests/contract3/**/fixtures/*-worker.ts",
    "tests/contract3/lifecycle/fixtures/declining-host.ts",
    "tests/contract3/state/fixtures/specimen.ts",
    "starters/contract3/src/addons/state/index.ts",
    "tests/contract3/kernel-repair/swarm-cli.ts",
    "tests/contract3/locks/fixtures.ts"
  ]
}
