{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "profiles/**",
    "examples/**",
    "starters/simple/**",
    "starters/complex/**",
    "starters/shared/**",
    "tools/oxlint/anti-slop/**"
  ],
  "ignoreBinaries": ["getconf"],
  "ignoreDependencies": ["@oxlint/plugins"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "audit": {
    "gate": "new-only"
  },
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": ["src/**"]
      },
      {
        "name": "scripts",
        "patterns": ["scripts/**"]
      },
      {
        "name": "kernel",
        "patterns": ["kernel/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**"]
      },
      {
        "name": "lint-config",
        "patterns": ["eslint.config.mjs", "eslint-rules.mjs", "config/**"]
      }
    ],
    "rules": [
      {
        "from": "cli",
        "allow": []
      },
      {
        "from": "scripts",
        "allow": ["cli"]
      },
      {
        "from": "kernel",
        "allow": []
      },
      {
        "from": "tests",
        "allow": ["cli", "scripts", "kernel", "lint-config"]
      },
      {
        "from": "lint-config",
        "allow": ["kernel"]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  },
  "health": {
    "ignore": [
      "kernel/**",
      "tests/kernel/**",
      "tests/glossary/**",
      "config/kernel-repository-rules.mjs"
    ]
  },
  "duplicates": {
    "ignoredClones": [
      "dup:9d3337d0:2",
      "dup:1ee378cf:2",
      "dup:16ad2cee:2",
      "dup:a7b229c2:2",
      "dup:6d052765:2",
      "dup:cd842ae0:2",
      "dup:6cb4227b:2"
    ]
  },
  "rules": {
    "dev-dependencies-in-production": "error",
    "private-type-leaks": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "boundary-violation": "error"
  },
  "entry": [
    "src/static-admission.ts",
    "scripts/doctor.ts",
    "scripts/check-commits.ts",
    "scripts/check-names.ts",
    "scripts/planted-faults.ts",
    "scripts/test-area.ts",
    "kernel/src/kernel/index.ts",
    "kernel/src/kernel/pattern-worker.ts",
    "kernel/src/addons/programs/index.ts",
    "kernel/src/addons/diagnostics/index.ts",
    "tests/kernel/**/fixtures/*-cli.ts",
    "tests/kernel/**/fixtures/*-worker.ts",
    "tests/kernel/lifecycle/fixtures/declining-host.ts",
    "tests/kernel/state/fixtures/specimen.ts",
    "kernel/src/addons/state/index.ts",
    "tests/kernel/kernel-repair/swarm-cli.ts",
    "tests/kernel/locks/fixtures.ts"
  ]
}
