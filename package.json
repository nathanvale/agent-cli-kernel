{
  "name": "agent-cli-kernel",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": "./kernel/src/kernel/index.ts",
    "./addons/approval": "./kernel/src/addons/approval/index.ts",
    "./addons/diagnostics": "./kernel/src/addons/diagnostics/index.ts",
    "./addons/programs": "./kernel/src/addons/programs/index.ts",
    "./addons/state": "./kernel/src/addons/state/index.ts",
    "./lint": "./kernel/config/kernel/eslint.mjs",
    "./lint-rules": "./kernel/config/kernel/eslint-rules.mjs",
    "./kernel-declaration.json": "./kernel/config/kernel/kernel-declaration.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "biome:check": "bun run format:check",
    "check": "bun run check:file-size && bun run lint && bun run format:check && bun run typecheck && bun run test && bun run --silent quality:fallow",
    "check:write": "bun run format",
    "quality:fallow": "node_modules/.bin/fallow audit --baseline-mode identity --format json --quiet",
    "doctor": "bun run scripts/doctor.ts",
    "check:commits": "bun run scripts/check-commits.ts",
    "check:file-size": "bun --no-install scripts/check-file-size.ts",
    "check:names": "bun run scripts/check-names.ts",
    "capability-qualification-run": "bun run tests/kernel/state/capability-qualification-run.ts",
    "fault-replay": "bun run scripts/planted-faults.ts replay",
    "planted-fault:add": "bun run scripts/planted-faults.ts add",
    "pretest": "bun run doctor",
    "test": "bun test --parallel=2 --path-ignore-patterns 'kernel/**'",
    "test:area": "bun run scripts/test-area.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "biome format .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2"
  },
  "peerDependencies": {
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "tiktoken": "1.0.22",
    "fallow": "3.43.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "fallow-type-aware": "3.43.2"
  },
  "overrides": {
    "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2"
  }
}
